# Copy to .env and fill in real values. Never commit .env.

FLASK_CONFIG=development
SECRET_KEY=change-me-to-a-long-random-string

# Default admin account, created on first start
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@thapar.edu
ADMIN_PASSWORD=change-me

# PostgreSQL (docker compose sets these for the containers)
POSTGRES_USER=placeiq
POSTGRES_PASSWORD=placeiq
POSTGRES_DB=placeiq
# Leave DATABASE_URL unset to use local SQLite (placement.db).
# DATABASE_URL=postgresql+psycopg://placeiq:placeiq@localhost:5432/placeiq

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
# Set true to run tasks inline without Redis (local dev only)
CELERY_TASK_ALWAYS_EAGER=true

# AI features (Phase 4+)
# ANTHROPIC_API_KEY=
