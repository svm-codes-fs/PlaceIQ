# Copy to .env and fill in real values. Never commit .env.

FLASK_APP=run.py
FLASK_CONFIG=development
# Use long random strings, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
# true when served over HTTPS (production)
JWT_COOKIE_SECURE=false

# Accounts created by `flask seed`
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@placeiq.dev
SEED_PASSWORD=change-me

# PostgreSQL (docker compose sets these for the containers)
POSTGRES_USER=placeiq
POSTGRES_PASSWORD=placeiq
POSTGRES_DB=placeiq
# Leave DATABASE_URL unset to use local SQLite (placeiq.db).
# DATABASE_URL=postgresql+psycopg://placeiq:placeiq@localhost:5432/placeiq

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
# Set true to run tasks inline without Redis (local dev only)
CELERY_TASK_ALWAYS_EAGER=true

# Live notifications: browser origins allowed to open a Socket.IO connection
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Offers not answered within this many days expire (checked hourly by Celery Beat)
OFFER_EXPIRY_DAYS=7

# Email: "console" logs messages (development); "smtp" sends them
EMAIL_BACKEND=console
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=PlaceIQ <no-reply@example.com>

# AI features. Without a key, resume parsing and interview scoring fall back to
# built-in heuristics (clearly labelled in the UI).
# ANTHROPIC_API_KEY=
